<?xml version="1.0"?>
<package format="3">
    <name>legged_unitree_hw</name>
    <version>0.0.0</version>
    <description>ROS 2 control hardware interface for Unitree robots.</description>
    <maintainer email="liaoqiayuan@gmail.com">Qiayuan Liao</maintainer>
    <license>BSD</license>
    <author email="liaoqiayuan@gmail.com">Qiayuan Liao</author>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <build_depend>cmake_clang_tools</build_depend>
    <depend>rclcpp</depend>
    <depend>geometry_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>std_msgs</depend>
    <depend>std_srvs</depend>
    <depend>hardware_interface</depend>
    <depend>pluginlib</depend>
    <depend>legged_common</depend>
    <depend>legged_hw</depend>

    <exec_depend>controller_manager</exec_depend>
    <exec_depend>joint_state_broadcaster</exec_depend>
    <exec_depend>legged_controllers</exec_depend>
    <exec_depend>legged_unitree_description</exec_depend>
    <exec_depend>legged_unitree_sim</exec_depend>
    <exec_depend>robot_state_publisher</exec_depend>
    <exec_depend>xacro</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
        <hardware_interface plugin="${prefix}/legged_unitree_hw_plugins.xml"/>
    </export>
</package>
