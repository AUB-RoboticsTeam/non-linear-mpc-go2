<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <ros2_control name="legged_mujoco_sim" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystem</plugin>
    </hardware>

    <xacro:macro name="hybrid_joint_mujoco" params="name initial_position:=0.0">
      <joint name="${name}">
        <command_interface name="effort"/>
        <state_interface name="position">
          <param name="initial_value">${initial_position}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <!-- Start near the nominal Go2 crouch. Before activation MuJoCo applies
         zero effort, matching ROS 1 LeggedHWSim, so gravity, damping and
         contacts may settle this pose naturally. The first height command is
         interpolated from the measured state over the MPC horizon. -->
    <xacro:hybrid_joint_mujoco name="LF_HAA" initial_position="0.0"/>
    <xacro:hybrid_joint_mujoco name="LF_HFE" initial_position="0.72"/>
    <xacro:hybrid_joint_mujoco name="LF_KFE" initial_position="-1.44"/>
    <xacro:hybrid_joint_mujoco name="RF_HAA" initial_position="0.0"/>
    <xacro:hybrid_joint_mujoco name="RF_HFE" initial_position="0.72"/>
    <xacro:hybrid_joint_mujoco name="RF_KFE" initial_position="-1.44"/>
    <xacro:hybrid_joint_mujoco name="LH_HAA" initial_position="0.0"/>
    <xacro:hybrid_joint_mujoco name="LH_HFE" initial_position="0.72"/>
    <xacro:hybrid_joint_mujoco name="LH_KFE" initial_position="-1.44"/>
    <xacro:hybrid_joint_mujoco name="RH_HAA" initial_position="0.0"/>
    <xacro:hybrid_joint_mujoco name="RH_HFE" initial_position="0.72"/>
    <xacro:hybrid_joint_mujoco name="RH_KFE" initial_position="-1.44"/>
  </ros2_control>
</robot>
