<mujoco model="go2">
  <compiler angle="radian" meshdir="assets" autolimits="true" />

  <option cone="elliptic" impratio="100" />

  <default>
    <default class="go2">
      <geom friction="0.4" margin="0.001" condim="1"/>
      <joint axis="0 1 0" damping="0.1" armature="0.01" frictionloss="0.2"/>
      <motor ctrlrange="-23.7 23.7"/>
      <default class="abduction">
        <joint axis="1 0 0" range="-1.0472 1.0472"/>
      </default>
      <default class="hip">
        <default class="front_hip">
          <joint range="-1.5708 3.4907"/>
        </default>
        <default class="back_hip">
          <joint range="-0.5236 4.5379"/>
        </default>
      </default>
      <default class="knee">
        <joint range="-2.7227 -0.83776"/>
        <motor ctrlrange="-45.43 45.43"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
        <default class="foot">
          <geom size="0.022" pos="-0.002 0 -0.213" priority="1" condim="6"
            friction="0.4 0.02 0.01"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="metal" rgba=".9 .95 .95 1" />
    <material name="black" rgba="0 0 0 1" />
    <material name="white" rgba="1 1 1 1" />
    <material name="gray" rgba="0.671705 0.692426 0.774270 1" />

    <mesh file="base_0.obj" />
    <mesh file="base_1.obj" />
    <mesh file="base_2.obj" />
    <mesh file="base_3.obj" />
    <mesh file="base_4.obj" />
    <mesh file="hip_0.obj" />
    <mesh file="hip_1.obj" />
    <mesh file="thigh_0.obj" />
    <mesh file="thigh_1.obj" />
    <mesh file="thigh_mirror_0.obj" />
    <mesh file="thigh_mirror_1.obj" />
    <mesh file="calf_0.obj" />
    <mesh file="calf_1.obj" />
    <mesh file="calf_mirror_0.obj" />
    <mesh file="calf_mirror_1.obj" />
    <mesh file="foot.obj" />
  </asset>

  <worldbody>
    <body name="base_link" pos="0 0 0.30" childclass="go2">
      <inertial pos="0.021112 0 -0.005366" quat="-0.000543471 0.713435 -0.00173769 0.700719"
        mass="6.921"
        diaginertia="0.107027 0.0980771 0.0244531" />
      <freejoint />
      <geom mesh="base_0" material="black" class="visual" />
      <geom mesh="base_1" material="black" class="visual" />
      <geom mesh="base_2" material="black" class="visual" />
      <geom mesh="base_3" material="white" class="visual" />
      <geom mesh="base_4" material="gray" class="visual" />
      <geom size="0.1881 0.04675 0.057" type="box" class="collision" />
      <geom size="0.05 0.045" pos="0.285 0 0.01" type="cylinder" class="collision" />
      <geom size="0.047" pos="0.293 0 -0.06" class="collision" />
      <site name="imu" pos="-0.02557 0 0.04232" />
      <!-- Invisible L1 point-cloud origin. The housing transform from the
           source Xacro is (0.25, -0.038, -0.03), but the Collada geometry
           starts at a corner. Unitree defines the scan origin at the center
           of the bottom mounting face, (37.5, 32.576, 0) mm in that mesh.
           The resulting base-frame position is below. Use an explicit
           wxyz quaternion so the rotation is exactly the original Go2 URDF
           RPY (2.94, 0, 1.5705), independent of MJCF Euler sequencing. -->
      <site name="lidar_l1_site" pos="0.281927411787 -0.000509459301 -0.023477308018"
        quat="0.071163679949 0.703621982354 0.703413511193 0.071142595368"
        size="0.001" rgba="0 0 0 0" />
      <body name="FL_hip" pos="0.1934 0.0465 0">
        <inertial pos="-0.0054 0.00194 -0.000105" quat="0.497014 0.499245 0.505462 0.498237"
          mass="0.678"
          diaginertia="0.00088403 0.000596003 0.000479967" />
        <joint name="LF_HAA" class="abduction" />
        <geom mesh="hip_0" material="metal" class="visual" />
        <geom mesh="hip_1" material="gray" class="visual" />
        <geom size="0.046 0.02" pos="0 0.08 0" quat="1 1 0 0" type="cylinder" class="collision" />
        <body name="FL_thigh" pos="0 0.0955 0">
          <inertial pos="-0.00374 -0.0223 -0.0327" quat="0.829533 0.0847635 -0.0200632 0.551623"
            mass="1.152"
            diaginertia="0.00594973 0.00584149 0.000878787" />
          <joint name="LF_HFE" class="front_hip" />
          <geom mesh="thigh_0" material="metal" class="visual" />
          <geom mesh="thigh_1" material="gray" class="visual" />
          <geom size="0.1065 0.01225 0.017" pos="0 0 -0.1065" quat="0.707107 0 0.707107 0"
            type="box" class="collision" />
          <body name="FL_calf" pos="0 0 -0.213">
            <inertial pos="0.00629595 -0.000622121 -0.141417"
              quat="0.710672 0.00154099 -0.00450087 0.703508"
              mass="0.241352" diaginertia="0.0014901 0.00146356 5.31397e-05" />
            <joint name="LF_KFE" class="knee" />
            <geom mesh="calf_0" material="gray" class="visual" />
            <geom mesh="calf_1" material="black" class="visual" />
            <geom size="0.012 0.06" pos="0.008 0 -0.06" quat="0.994493 0 -0.104807 0"
              type="cylinder" class="collision" />
            <geom size="0.011 0.0325" pos="0.02 0 -0.148" quat="0.999688 0 0.0249974 0"
              type="cylinder" class="collision" />
            <geom pos="0 0 -0.213" mesh="foot" class="visual" material="black" />
            <body name="FL_foot" pos="0 0 -0.213">
              <!-- Explicit near-zero inertial: without it MuJoCo auto-infers
                   mass/inertia from the geom below (since this body has no
                   <inertial> of its own), adding ~0.045kg per foot that
                   wasn't there when this geom lived on the calf (which has
                   its own explicit <inertial> that ignores geom mass). This
                   keeps total robot mass/inertia matching the precise
                   composite calculation used for the robot's tuned
                   mass/inertia constants. -->
              <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6" />
              <!-- The foot collision geom lives here (not on the calf), so the
                   FL_foot_force/torque sensors below, attached to this
                   body's site, measure the true ground contact wrench
                   transmitted through this body's weld to the calf, not the
                   calf's own combined dynamics. pos is offset by -0.213 in z
                   from the original calf-relative default (-0.002 0 -0.213)
                   to land at the same global location now that it's a child
                   of this body instead of the calf. -->
              <geom name="FL" class="foot" pos="-0.002 0 0" />
              <site name="FL_foot_site" size="0.01"/>
            </body>
          </body>
        </body>
      </body>
      <body name="FR_hip" pos="0.1934 -0.0465 0">
        <inertial pos="-0.0054 -0.00194 -0.000105" quat="0.498237 0.505462 0.499245 0.497014"
          mass="0.678"
          diaginertia="0.00088403 0.000596003 0.000479967" />
        <joint name="RF_HAA" class="abduction" />
        <geom mesh="hip_0" material="metal" class="visual" quat="4.63268e-05 1 0 0" />
        <geom mesh="hip_1" material="gray" class="visual" quat="4.63268e-05 1 0 0" />
        <geom size="0.046 0.02" pos="0 -0.08 0" quat="0.707107 0.707107 0 0" type="cylinder"
          class="collision" />
        <body name="FR_thigh" pos="0 -0.0955 0">
          <inertial pos="-0.00374 0.0223 -0.0327" quat="0.551623 -0.0200632 0.0847635 0.829533"
            mass="1.152"
            diaginertia="0.00594973 0.00584149 0.000878787" />
          <joint name="RF_HFE" class="front_hip" />
          <geom mesh="thigh_mirror_0" material="metal" class="visual" />
          <geom mesh="thigh_mirror_1" material="gray" class="visual" />
          <geom size="0.1065 0.01225 0.017" pos="0 0 -0.1065" quat="0.707107 0 0.707107 0"
            type="box" class="collision" />
          <body name="FR_calf" pos="0 0 -0.213">
            <inertial pos="0.00629595 0.000622121 -0.141417"
              quat="0.703508 -0.00450087 0.00154099 0.710672"
              mass="0.241352" diaginertia="0.0014901 0.00146356 5.31397e-05" />
            <joint name="RF_KFE" class="knee" />
            <geom mesh="calf_mirror_0" material="gray" class="visual" />
            <geom mesh="calf_mirror_1" material="black" class="visual" />
            <geom size="0.013 0.06" pos="0.01 0 -0.06" quat="0.995004 0 -0.0998334 0"
              type="cylinder" class="collision" />
            <geom size="0.011 0.0325" pos="0.02 0 -0.148" quat="0.999688 0 0.0249974 0"
              type="cylinder" class="collision" />
            <geom pos="0 0 -0.213" mesh="foot" class="visual" material="black" />
            <body name="FR_foot" pos="0 0 -0.213">
              <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6" />
              <geom name="FR" class="foot" pos="-0.002 0 0" />
              <site name="FR_foot_site" size="0.01"/>
            </body>
          </body>
        </body>
      </body>
      <body name="RL_hip" pos="-0.1934 0.0465 0">
        <inertial pos="0.0054 0.00194 -0.000105" quat="0.505462 0.498237 0.497014 0.499245"
          mass="0.678"
          diaginertia="0.00088403 0.000596003 0.000479967" />
        <joint name="LH_HAA" class="abduction" />
        <geom mesh="hip_0" material="metal" class="visual" quat="4.63268e-05 0 1 0" />
        <geom mesh="hip_1" material="gray" class="visual" quat="4.63268e-05 0 1 0" />
        <geom size="0.046 0.02" pos="0 0.08 0" quat="0.707107 0.707107 0 0" type="cylinder"
          class="collision" />
        <body name="RL_thigh" pos="0 0.0955 0">
          <inertial pos="-0.00374 -0.0223 -0.0327" quat="0.829533 0.0847635 -0.0200632 0.551623"
            mass="1.152"
            diaginertia="0.00594973 0.00584149 0.000878787" />
          <joint name="LH_HFE" class="back_hip" />
          <geom mesh="thigh_0" material="metal" class="visual" />
          <geom mesh="thigh_1" material="gray" class="visual" />
          <geom size="0.1065 0.01225 0.017" pos="0 0 -0.1065" quat="0.707107 0 0.707107 0"
            type="box" class="collision" />
          <body name="RL_calf" pos="0 0 -0.213">
            <inertial pos="0.00629595 -0.000622121 -0.141417"
              quat="0.710672 0.00154099 -0.00450087 0.703508"
              mass="0.241352" diaginertia="0.0014901 0.00146356 5.31397e-05" />
            <joint name="LH_KFE" class="knee" />
            <geom mesh="calf_0" material="gray" class="visual" />
            <geom mesh="calf_1" material="black" class="visual" />
            <geom size="0.013 0.06" pos="0.01 0 -0.06" quat="0.995004 0 -0.0998334 0"
              type="cylinder" class="collision" />
            <geom size="0.011 0.0325" pos="0.02 0 -0.148" quat="0.999688 0 0.0249974 0"
              type="cylinder" class="collision" />
            <geom pos="0 0 -0.213" mesh="foot" class="visual" material="black" />
            <body name="RL_foot" pos="0 0 -0.213">
              <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6" />
              <geom name="RL" class="foot" pos="-0.002 0 0" />
              <site name="RL_foot_site" size="0.01"/>
            </body>
          </body>
        </body>
      </body>
      <body name="RR_hip" pos="-0.1934 -0.0465 0">
        <inertial pos="0.0054 -0.00194 -0.000105" quat="0.499245 0.497014 0.498237 0.505462"
          mass="0.678"
          diaginertia="0.00088403 0.000596003 0.000479967" />
        <joint name="RH_HAA" class="abduction" />
        <geom mesh="hip_0" material="metal" class="visual"
          quat="2.14617e-09 4.63268e-05 4.63268e-05 -1" />
        <geom mesh="hip_1" material="gray" class="visual"
          quat="2.14617e-09 4.63268e-05 4.63268e-05 -1" />
        <geom size="0.046 0.02" pos="0 -0.08 0" quat="0.707107 0.707107 0 0" type="cylinder"
          class="collision" />
        <body name="RR_thigh" pos="0 -0.0955 0">
          <inertial pos="-0.00374 0.0223 -0.0327" quat="0.551623 -0.0200632 0.0847635 0.829533"
            mass="1.152"
            diaginertia="0.00594973 0.00584149 0.000878787" />
          <joint name="RH_HFE" class="back_hip" />
          <geom mesh="thigh_mirror_0" material="metal" class="visual" />
          <geom mesh="thigh_mirror_1" material="gray" class="visual" />
          <geom size="0.1065 0.01225 0.017" pos="0 0 -0.1065" quat="0.707107 0 0.707107 0"
            type="box" class="collision" />
          <body name="RR_calf" pos="0 0 -0.213">
            <inertial pos="0.00629595 0.000622121 -0.141417"
              quat="0.703508 -0.00450087 0.00154099 0.710672"
              mass="0.241352" diaginertia="0.0014901 0.00146356 5.31397e-05" />
            <joint name="RH_KFE" class="knee" />
            <geom mesh="calf_mirror_0" material="gray" class="visual" />
            <geom mesh="calf_mirror_1" material="black" class="visual" />
            <geom size="0.013 0.06" pos="0.01 0 -0.06" quat="0.995004 0 -0.0998334 0"
              type="cylinder" class="collision" />
            <geom size="0.011 0.0325" pos="0.02 0 -0.148" quat="0.999688 0 0.0249974 0"
              type="cylinder" class="collision" />
            <geom pos="0 0 -0.213" mesh="foot" class="visual" material="black" />
            <body name="RR_foot" pos="0 0 -0.213">
              <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6" />
              <geom name="RR" class="foot" pos="-0.002 0 0" />
              <site name="RR_foot_site" size="0.01"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor class="abduction" name="FR_hip" joint="RF_HAA" />
    <motor class="hip" name="FR_thigh" joint="RF_HFE" />
    <motor class="knee" name="FR_calf" joint="RF_KFE" />
    <motor class="abduction" name="FL_hip" joint="LF_HAA" />
    <motor class="hip" name="FL_thigh" joint="LF_HFE" />
    <motor class="knee" name="FL_calf" joint="LF_KFE" />
    <motor class="abduction" name="RR_hip" joint="RH_HAA" />
    <motor class="hip" name="RR_thigh" joint="RH_HFE" />
    <motor class="knee" name="RR_calf" joint="RH_KFE" />
    <motor class="abduction" name="RL_hip" joint="LH_HAA" />
    <motor class="hip" name="RL_thigh" joint="LH_HFE" />
    <motor class="knee" name="RL_calf" joint="LH_KFE" />
  </actuator>

  <sensor>
    <!-- Named to match mujoco_ros2_control's convention: a ros2_control
         <sensor name="unitree_imu"> strips the last "_"-separated token
         ("imu") off the name and looks for "<rest>_quat"/"_gyro"/"_accel",
         i.e. "unitree_quat"/"unitree_gyro"/"unitree_accel" here. -->
    <framequat name="unitree_quat" objtype="site" objname="imu" />
    <gyro name="unitree_gyro" site="imu" />
    <accelerometer name="unitree_accel" site="imu" />

    <!-- Ground-truth base pose/velocity, not consumed by mujoco_ros2_control
         today; kept for future odometry/TF work. -->
    <framepos name="trunk_frame_pos" objtype="site" objname="imu" />
    <framelinvel name="trunk_frame_vel" objtype="site" objname="imu" />

    <!-- Foot force/torque sensors, matching the real Go2's per-foot force
         sensing. Each X_foot body is welded (no joint) to its calf, so a
         force/torque sensor at a site on it reads the reaction force/torque
         transmitted through that weld: the true ground contact wrench, not
         an approximation. Named to match mujoco_ros2_control's "_fts"
         convention: a ros2_control <sensor name="X_foot_fts"> strips "_fts"
         and looks for "X_foot_force"/"X_foot_torque" here. -->
    <force name="FR_foot_force" site="FR_foot_site" />
    <torque name="FR_foot_torque" site="FR_foot_site" />
    <force name="FL_foot_force" site="FL_foot_site" />
    <torque name="FL_foot_torque" site="FL_foot_site" />
    <force name="RR_foot_force" site="RR_foot_site" />
    <torque name="RR_foot_torque" site="RR_foot_site" />
    <force name="RL_foot_force" site="RL_foot_site" />
    <torque name="RL_foot_torque" site="RL_foot_site" />
  </sensor>

  <keyframe>
    <key name="home" qpos="0 0 0.27 1 0 0 0 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8"
      ctrl="0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8" />
  </keyframe>
</mujoco>
