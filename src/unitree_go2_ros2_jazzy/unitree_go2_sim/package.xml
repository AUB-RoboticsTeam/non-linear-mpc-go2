<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unitree_go2_sim</name>
  <version>0.0.0</version>
  <description>unitree go2 robot simulation</description>
  <maintainer email="khaledgabr77@gmail.com">khaled</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>launch_ros</build_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <!-- MuJoCo backend (unitree_go2_launch_mujoco.py); see mujoco_ros2_control's
       NOTICE.md for the MuJoCo library install step this package needs. -->
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>force_torque_sensor_broadcaster</exec_depend>
  <exec_depend>legged_controllers</exec_depend>
  <exec_depend>legged_unitree_description</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
